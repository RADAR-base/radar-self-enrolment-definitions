      "title": "Frequently Asked Questions",
      "items": [
        {
          "title": "Am I eligible?",
          "content": "If you are aged 18 or over, live in the UK, are fluent in English, and have PMDD, you may be eligible. If you are currently pregnant, breastfeeding, or on hormonal contraception, you are not eligible."
        },
        {
          "title": "How do I sign up?",
          "content": "Click the Join Study button and follow the steps to create an account, read the Information Sheet, give consent, and complete the initial questionnaire."
        },
        {
          "title": "I own a wearable. What devices are eligible?",
          "content": "Examples include Apple Watch (with iPhone via HealthKit), Fitbit, Garmin, and Oura."
        },
        {
          "title": "Which wearable data will you collect?",
          "content": "With your permission, we will collect passive data such as daily activity, sleep duration and quality, and heart-rate metrics from your connected wearable or health app."
        }
      ]
