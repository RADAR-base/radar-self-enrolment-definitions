      "metadata": {
        "title": "Connect Devices",
        "order": 2,
        "description": "Share your fitness tracker or smartphone app with us.",
        "optional": false,
        "type": "inbuilt",
        "inbuiltId": "connect",
        "options": {
          "title": "TASK: Connect my device(s)",
          "description": "<p>Click on the connect button for your device.</p><p>The study team will collect activity, sleep, and health data from your wearable devices or smartphone apps. This data will be collected securely via RADAR-base. Once you have connected your devices, you can sign out of this portal.</p>",
          "devices": [
            {
              "id": "fitbit",
              "title": "Fitbit",
              "description": "By clicking Connect, you can read step-by-step instructions to see how to share your Fitbit data. We are collecting physical activity, heart rate, and sleep data.",
              "guideUrl": "https://canva.link/7aymaosboigy27y"
            },
            {
              "id": "garmin",
              "title": "Garmin",
              "description": "By clicking Connect, you can read step-by-step instructions to see how to share your Garmin data. We are collecting physical activity, heart rate, and sleep data.",
              "guideUrl": "https://canva.link/7aymaosboigy27y"
            },
            {
              "id": "oura",
              "title": "Oura Ring",
              "description": "By clicking Connect, you can read step-by-step instructions to see how to share your Oura Ring data. We are collecting physical activity, heart rate, temperature, and sleep data.",
              "guideUrl": "https://canva.link/7aymaosboigy27y"
            },
            {
              "id": "radar_armt",
              "title": "RADAR Questionnaire App",
              "description": "By clicking Connect, you can read step-by-step instructions to see how to share your RADAR aRMT physical activity, heart rate, and sleep data.",
              "guideUrl": "https://canva.link/523uysldcjyimi7"
            }
          ]
        }
      }
    }
  ],
