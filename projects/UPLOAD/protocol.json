      "metadata": {
        "title": "Connect Devices",
        "description": "Share your wearable device or smartphone app data with us.",
        "optional": false,
        "type": "inbuilt",
        "inbuiltId": "connect",
        "options": {
          "title": "TASK: Connect my device(s)",
          "description": "<p>Click on the connect button for your device.</p><p>The study team will collect activity, sleep, and health data from your wearable devices or smartphone apps. This data will be collected securely via RADAR-base. Once you have connected your devices, you can sign out of this portal.</p>",
          "devices": [
            {
              "id": "fitbit",
              "title": "Fitbit",
              "description": "By clicking Connect, you can read step-by-step instructions to see how to share your Fitbit data. We are collecting physical activity, heart rate, and sleep data.",
              "guideUrl": ""
            },
            {
              "id": "garmin",
              "title": "Garmin",
              "description": "By clicking Connect, you can read step-by-step instructions to see how to share your Garmin data. We are collecting physical activity, heart rate, and sleep data.",
              "guideUrl": ""
            },
            {
              "id": "oura",
              "title": "Oura Ring",
              "description": "By clicking Connect, you can read step-by-step instructions to see how to share your Oura Ring data. We are collecting physical activity, heart rate, temperature, and sleep data.",
              "guideUrl": ""
            }
          ]
        }
      }
    }
  ],
  "enrolment": {
    "studyInformation": {
      "title": "Study Information",
      "content": "Please take some time to review the Participant Information Sheet, as it contains answers to many common questions related to taking part. If you have any questions, please contact the team at <CRIS.Administrator@slam.nhs.uk>.\n<br />\n<PdfViewer fileUrl='https://raw.githubusercontent.com/RADAR-base/radar-self-enrolment-definitions/refs/heads/dev/projects/UPLOAD/resources/pis.pdf'/>\n<br />\n<button variant='contained' target='_blank' href='https://raw.githubusercontent.com/RADAR-base/radar-self-enrolment-definitions/refs/heads/dev/projects/UPLOAD/resources/pis.pdf'>Download Participant Information</button>"
    },
    "additional": {
      "title": "Register Account",
      "items": [
        {
          "field_name": "upload_additional_heading",
          "form_name": "upload_additional",
          "field_type": "descriptive",
          "field_label": "You need an account to connect your wearable device or smartphone app so we can collect activity, sleep, and health data. You can find out more information about the way we use personal information in our [privacy policy](privacy)."
        },
        {
          "field_name": "hospital_number",
