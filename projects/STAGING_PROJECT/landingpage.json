      "noCard": true,
      "content": {
        "block1": {
          "blockType": "hero",
          "title": "Our Aims",
          "subtitle": "Our goal is to generate evidence that can inform healthier digital habits and improve sleep hygiene recommendations."
        },
        "block2": {
          "blockType": "markdown",
          "content": "<div style='display:flex; gap: 1rem; flex-direction:column;'><div style='background-color:white; border-radius:48px; padding:2rem'><h2>Investigate whether increased screen time before sleep is associated with:</h2><br /><p>Delayed sleep onset<br />Shorter sleep duration<br />Reduced sleep efficiency</p></div><div style='background-color: white; border-radius: 48px; padding:2rem'><h2>Examine whether different app categories (e.g., social media, gaming, productivity) have different effects on sleep</h2></div><div style='background-color: white; border-radius: 48px; padding:2rem'><h2>Compare sleep patterns across different age groups</h2></div><div style='background-color: white; border-radius: 48px; padding:2rem'><h2>Explore long-term sleep behaviour over several months</h2></div></div>"
        }
      }
    },

