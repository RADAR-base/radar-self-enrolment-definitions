      "noCard": true,
      "content": {
        "block1": {
          "blockType": "markdown",
          "content": "<div id='test'><h1>Study of Sleep Hygiene & Health (SSHH)</h1>\n<br /><h2 style='fontWeight: normal;'>Discover How Your Mobile Phone Usage affects your Sleep</h2><button style='fontSize: 2rem; padding: 10px 24px; margin: 1rem 0; align-self:flex-start' variant='contained' href='STAGING_PROJECT/enrol'>Join Study</button></div>"
        },
        "block2": {
          "blockType": "video",
          "video": {
            "src": "https://raw.githubusercontent.com/RADAR-base/radar-self-enrolment-definitions/refs/heads/main/projects/RADAR-GLAD-KCL-s1/resources/video.mp4",
            "type": "video/mp4",
            "width": "100%",
            "params": {
              "controls": true,
              "muted": false,
              "autoPlay": false,
              "playsInline": true
            }
          }
        }
      }
    },

    {
      "blockType": "hero",
      "noCard": true,
      "blockBackground": "#9775bd",
      "sx": {
        "color": "#ffffff",
        "justifyContent": "center",
        "alignItems": "center",
        "alignContent": "center",
        "textAlign": "center",

        "& .MuiBox-root": {
          "flex": "none",
          "width": "100%",
          "gap": "0"
        },

        "& .MuiTypography-h1": {
          "fontSize": "3rem",
          "flex": "none",
          "width": "100%",
          "textAlign": "left"
        },

        "@media only screen and (max-device-width: 480px)": {
          "& .MuiBox-root": {
            "justifyContent": "center"
          },
          "& .MuiTypography-h1": {
            "fontSize": "1.5rem",
            "textAlign": "center"
          }
        }
      },
      "title": "Smartphones are now an integral part of daily life. Many people use their phones before bed — for social media, messaging, gaming, or watching videos. However, it is not fully understood how different types of phone interactions influence sleep."
    },

    {
      "blockType": "column",
